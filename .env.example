# 复制成 .env 后填值。.env 已在 .gitignore 里，绝不提交。
# 一旦不小心把真实 key 提交过，立刻去服务商后台吊销并重新签发（删历史不算撤回）。

# --- 主力模型服务商 ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# --- 备用：跑评测集时用的低价模型（W21 起需要） ---
# EVAL_LLM_API_KEY=
# EVAL_LLM_BASE_URL=
# EVAL_LLM_MODEL=

# --- 行为参数（非敏感，可留默认） ---
LOG_LEVEL=INFO
MAX_AGENT_STEPS=8
REQUEST_TIMEOUT=120
